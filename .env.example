# --- Marquee environment ---
# Copy this file to ".env" and fill in your keys. ".env" is git-ignored.
# These are EXPO_PUBLIC_* so they are inlined into the client bundle at build time.

# TMDB API v3 (required). Free key: https://www.themoviedb.org/settings/api
# Use your v3 "API Key" (the short one), not the v4 bearer token.
EXPO_PUBLIC_TMDB_KEY=your_tmdb_v3_api_key_here

# OMDb API (optional). Free key (1,000 req/day): https://www.omdbapi.com/apikey.aspx
# When set, the detail screen shows IMDB / Rotten Tomatoes / Metascore badges.
# Leave blank to disable enrichment.
EXPO_PUBLIC_OMDB_KEY=your_omdb_api_key_here
